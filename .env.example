# Copy this file to .env.local and fill in your values
# Get Supabase credentials from: supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe — get from stripe.com/dashboard
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Stripe Price IDs — create these in Stripe dashboard
STRIPE_PRO_PRICE_ID=price_...                    # legacy fallback (monthly)
STRIPE_PRO_MONTHLY_PRICE_ID=price_...            # £29/month
STRIPE_PRO_ANNUAL_PRICE_ID=price_...             # £290/year
STRIPE_FOUNDING_PRICE_ID=price_...               # £199/year (founding member)
NEXT_PUBLIC_STRIPE_FOUNDING_PRICE_ID=price_...   # same as above (for client)
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — get from resend.com
RESEND_API_KEY=re_...

# GoCardless — get from gocardless.com
GOCARDLESS_ACCESS_TOKEN=...
GOCARDLESS_ENVIRONMENT=live

# App URL
NEXT_PUBLIC_APP_URL=https://app.letflowuk.com
